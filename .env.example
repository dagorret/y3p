# =============================================================================
# PLANTILLA DE CONFIGURACIÓN - MT^3 / Y3P
# =============================================================================
# Copiar este archivo como '.env' y completar con los valores reales.

DEBUG=True
SECRET_KEY="django-insecure-genera-una-clave-aqui"

# Conexión PostgreSQL (Formato: postgres://usuario:password@host:puerto/nombre_db)
DATABASE_URL="postgres://postgres:root@127.0.0.1:5432/postgres"

# Simulación local (True = No toca APIs reales / False = Producción)
ENABLE_LOCAL_MOCKS=True
CRM_DRY_RUN=True

# Microsoft 365 / Entra ID
AZURE_TENANT_ID="tu-tenant-id"
AZURE_CLIENT_ID="tu-client-id"
AZURE_CLIENT_SECRET="tu-secret-de-azure"
AZURE_STUDENT_SKU_ID="sku-alumnos"
AZURE_TEACHER_SKU_ID="sku-docentes"

# Moodle FCE
MOODLE_BASE_URL="https://moodle.eco.unrc.edu.ar"
MOODLE_REST_TOKEN="tu-token-de-moodle"

# SIAL / UTI
SIAL_BASE_URL="https://sial.unrc.edu.ar/api"
SIAL_USER="usuario-sial"
SIAL_PASSWORD="password-sial"

# Correo SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notificaciones@eco.unrc.edu.ar"
SMTP_PASSWORD="tu-password-de-aplicacion"
